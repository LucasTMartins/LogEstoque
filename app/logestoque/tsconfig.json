{
  "compilerOptions": {
    "target": "es2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "allowJs": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "rootDir": "./webapp",
    "outDir": "./dist",
    "paths": {
      "br/dev/imlucas/logestoque/*": [
        "./webapp/*"
      ]
    },
    "types": ["@sapui5/types"],
    "esModuleInterop": true
  },
  "include": [
    "./webapp/**/*"
  ]
}
