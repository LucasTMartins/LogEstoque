<mvc:View
    controllerName="logestoque.login.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        title="LogEstoque"
        id="loginPage"
        showHeader="true"
    >
        <content>
            <VBox
                class="sapUiMediumMargin"
                alignItems="Center"
                id="vboxLogin"
            >
                <Label
                    text="Usuário"
                    id="lblUsername"
                />
                <Input
                    id="username"
                    type="Text"
                    width="300px"
                />
                <Label
                    text="Senha"
                    id="lblPassword"
                />
                <Input
                    id="password"
                    type="Password"
                    width="300px"
                />
                <Button
                    id="btnLogin"
                    text="Entrar"
                    press="onLogin"
                    type="Emphasized"
                    width="300px"
                />
                <Text
                    id="errorMessage"
                    visible="false"
                    text=""
                />
            </VBox>
        </content>
    </Page>
</mvc:View>
