# ─── Autenticação ────────────────────────────────────────────────────────────
# Chave de assinatura JWT. Mínimo 32 caracteres. Obrigatório.
JWT_SECRET=troque-para-uma-chave-secreta-com-pelo-menos-32-caracteres

# Tempo de expiração do token JWT (ex: 8h, 1d, 30m)
JWT_EXPIRES_IN=8h

# ─── Servidor ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=4004
NODE_ENV=production

# ─── Nginx ───────────────────────────────────────────────────────────────────
# Domínio público usado no server_name e nos paths dos certificados Let's Encrypt
NGINX_HOST=seu.dominio.com

# ─── Banco de Dados (PostgreSQL — apenas produção) ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=logestoque
DB_USER=logestoque
DB_PASSWORD=troque-para-uma-senha-segura
